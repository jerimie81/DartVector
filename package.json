{
  "name": "ai-DartVector",
  "version": "0.1.0",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:win": "npm run build && electron-builder --win --x64",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "next clean",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.jerimie81.dartvector",
    "productName": "DartVector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      ".next/standalone/**",
      ".next/static/**",
      "public/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DartVector-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "firebase": "^12.18.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "jsdom": "^26.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.9"
  }
}
