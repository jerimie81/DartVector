    "@types/react-dom": "^19",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
