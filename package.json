{
  "name": "ai-DartVector",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build-win": "next build && electron-builder --win --x64",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "next clean",
    "electron": "electron ."
  },
  "build": {
