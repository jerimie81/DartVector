rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users Profile Collection (Locked down: only owner can read and write)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User Match History Subcollection
      match /matches/{matchId} {
        allow read, write: if isOwner(userId);
      }
      
      // User Custom Players Subcollection
      match /custom_players/{playerId} {
        allow read, write: if isOwner(userId);
      }

      // User House Leagues Subcollection
      match /leagues/{leagueId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Real-Time Online Multiplayer Rooms
    match /rooms/{roomCode} {
      allow read: if true;
      allow create, update: if roomCode.size() == 6;
      allow delete: if isAuthenticated();
    }
  }
}
